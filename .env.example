# Copy to .env and replace every change-me value. Never commit .env.
# Passwords are embedded in connection URLs: use URL-safe characters only.

# --- API ---
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- PostgreSQL (container superuser, only used to bootstrap the database) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aud

# Host port for local development (bound to 127.0.0.1 only)
DB_PORT=5432

# --- Application roles (created by deploy/initdb on first start) ---
# aud_owner owns the schema and runs migrations.
AUD_OWNER_PASSWORD=change-me
# aud_app is the runtime role: INSERT and SELECT only.
AUD_APP_PASSWORD=change-me

# --- API runtime ---
# Connection as aud_app (INSERT and SELECT only). Fill in the values from above.
DATABASE_URL=postgres://aud_app:change-me@localhost:5432/aud?sslmode=disable
# Base64 of 32 random bytes: openssl rand -base64 32. Set once; changing it invalidates every client secret.
AUD_SECRET_KEY=change-me
# Ingest queue size, in pending submissions.
QUEUE_CAPACITY=1024

# --- Query API (JWT) ---
# Without this file the query API stays disabled. Generate a local pair with: audctl jwt keygen
AUD_JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
# Optional: when set, tokens must carry this iss and aud.
AUD_JWT_ISSUER=
AUD_JWT_AUDIENCE=

# --- audctl (client provisioning, runs as aud_owner) ---
AUD_ADMIN_DATABASE_URL=postgres://aud_owner:change-me@localhost:5432/aud?sslmode=disable
